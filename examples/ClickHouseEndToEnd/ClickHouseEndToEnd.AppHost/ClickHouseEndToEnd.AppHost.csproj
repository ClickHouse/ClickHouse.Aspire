<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.0.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <!-- ASPIRE010: Aspire 13.5+ advises opting into the Aspire CLI bundle. This
         example is only ever built, never launched through the Aspire CLI, so the
         bundle would add a download to every build for no benefit here. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Aspire.Hosting.ClickHouse\Aspire.Hosting.ClickHouse.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\ClickHouseEndToEnd.ApiService\ClickHouseEndToEnd.ApiService.csproj" />
  </ItemGroup>

</Project>
